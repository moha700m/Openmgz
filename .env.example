# ------------------------------------------------------------------
# Openmgz — server configuration
# ------------------------------------------------------------------

# Local server
PORT=4400

# GitHub repository that receives build branches and runs the workflow.
GITHUB_REPO=moha700m/Openmgz

# Fine-grained PAT with: Contents (read/write), Actions (read/write), Workflows (read/write)
# Never commit this file with a real token.
GITHUB_TOKEN=

# Workflow file name inside .github/workflows
GITHUB_WORKFLOW=ios-ipa.yml

# Branches that carry generated projects
BUILD_BRANCH_PREFIX=openmgz/build-

# Safety limits
MAX_ARCHIVE_BYTES=125829120
MAX_EXTRACTED_BYTES=629145600
MAX_ENTRIES=20000

# How often the server polls GitHub for build status (ms)
POLL_MS=8000
